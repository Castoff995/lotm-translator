{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://castoff995.github.io/lotm-translator/schemas/v2/pairwise-alignment-proposal.schema.json",
  "title": "LOTM v2 Pairwise Alignment Proposal",
  "type": "object",
  "required": [
    "schema_version", "artifact_type", "work_id", "chapter", "direction",
    "coverage_mode", "left_source", "right_source", "producer", "units"
  ],
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "source_id", "language", "normalized_path", "normalized_sha256",
        "normalized_schema_version", "paragraph_count"
      ],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "language": {"enum": ["zh", "en", "ru"]},
        "normalized_path": {"type": "string", "minLength": 1},
        "normalized_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "normalized_schema_version": {"type": "string", "minLength": 1},
        "paragraph_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "side": {
      "oneOf": [
        {
          "type": "object",
          "required": ["paragraphs"],
          "properties": {
            "paragraphs": {
              "type": "array",
              "minItems": 1,
              "description": "Ordered whole-Paragraph IDs; runtime validation requires one contiguous physical range.",
              "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*:[0-9]{4}:p[0-9]{6}$"}
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["unmatched"],
          "properties": {"unmatched": {"const": true}},
          "additionalProperties": false
        }
      ]
    },
    "score": {
      "type": "object",
      "required": ["name", "value", "semantics"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "value": {"type": "number"},
        "semantics": {"type": "string", "minLength": 1, "pattern": "\\S"}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {"const": "1.0-draft"},
    "artifact_type": {"const": "pairwise_alignment_proposal"},
    "work_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "chapter": {"type": "integer", "minimum": 1},
    "direction": {"enum": ["zh-en", "zh-ru"]},
    "coverage_mode": {"enum": ["partial", "complete"]},
    "left_source": {"$ref": "#/$defs/source"},
    "right_source": {"$ref": "#/$defs/source"},
    "producer": {
      "type": "object",
      "required": ["producer_id", "producer_version", "parameters", "parameters_sha256", "code_revision"],
      "properties": {
        "producer_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "producer_version": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "parameters": {"type": "object"},
        "parameters_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "code_revision": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"}
      },
      "additionalProperties": false
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "left", "right"],
        "properties": {
          "id": {"type": "string", "pattern": "^u[0-9]{6}$"},
          "left": {"$ref": "#/$defs/side"},
          "right": {"$ref": "#/$defs/side"},
          "scores": {"type": "array", "items": {"$ref": "#/$defs/score"}}
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "properties": {"left_source": {"properties": {"language": {"const": "zh"}}}}
    },
    {
      "if": {"properties": {"direction": {"const": "zh-en"}}, "required": ["direction"]},
      "then": {"properties": {"right_source": {"properties": {"language": {"const": "en"}}}}}
    },
    {
      "if": {"properties": {"direction": {"const": "zh-ru"}}, "required": ["direction"]},
      "then": {"properties": {"right_source": {"properties": {"language": {"const": "ru"}}}}}
    }
  ],
  "additionalProperties": false
}
