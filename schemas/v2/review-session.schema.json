{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://castoff995.github.io/lotm-translator/schemas/v2/review-session.schema.json",
  "title": "LOTM v2 Persistent Review Session",
  "type": "object",
  "required": [
    "session_schema_version", "review_semantics_version", "session_id", "status",
    "created_with_reviewer", "last_opened_with_reviewer", "created_at", "updated_at",
    "target_gold_path", "target_gold_schema_version", "base_gold_sha256",
    "work_id", "chapter", "source_snapshot", "working_gold"
  ],
  "properties": {
    "session_schema_version": {"const": "1.0-draft"},
    "review_semantics_version": {"const": "1.0"},
    "session_id": {"type": "string", "format": "uuid"},
    "status": {"enum": ["active", "published", "discarded"]},
    "created_with_reviewer": {"type": "string", "minLength": 1},
    "last_opened_with_reviewer": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "target_gold_path": {"type": "string", "minLength": 1},
    "target_gold_schema_version": {"type": "string", "minLength": 1},
    "base_gold_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "work_id": {"type": "string", "minLength": 1},
    "chapter": {"type": "integer", "minimum": 1},
    "source_snapshot": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "language", "normalized_path", "normalized_sha256", "normalized_schema_version", "paragraph_count"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "language": {"enum": ["zh", "en", "ru"]},
          "normalized_path": {"type": "string", "minLength": 1},
          "normalized_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "normalized_schema_version": {"type": "string", "minLength": 1},
          "paragraph_count": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "working_gold": {"$ref": "gold-chapter.schema.json"},
    "publication_expected_gold_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "publication_started_at": {"type": ["string", "null"]},
    "published_gold_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "published_at": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
