{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://castoff995.github.io/lotm-translator/schemas/v2/epub-paragraphization-artifact.schema.json",
  "title": "LOTM v2 EPUB Structural Paragraphization Artifact",
  "type": "object",
  "required": ["schema_version", "artifact_version", "status", "work_id", "source_id", "chapter", "raw_epub_sha256", "extraction_profile", "toc_index", "toc_label", "toc_href", "segments", "paragraphs", "structural_events"],
  "properties": {
    "schema_version": {"const": "1.0-draft"},
    "artifact_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "confirmed"]},
    "work_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "chapter": {"type": "integer", "minimum": 1},
    "raw_epub_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "extraction_profile": {"type": "string", "minLength": 1},
    "toc_index": {"type": "integer", "minimum": 0},
    "toc_label": {"type": "string"},
    "toc_href": {"type": "string", "minLength": 1},
    "segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/segment"}},
    "paragraphs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/paragraph"}},
    "structural_events": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false,
  "$defs": {
    "segment": {
      "type": "object",
      "required": ["document_href", "spine_index", "start_dom_path", "end_dom_path"],
      "properties": {
        "document_href": {"type": "string", "minLength": 1},
        "spine_index": {"type": "integer", "minimum": 0},
        "start_dom_path": {"type": ["string", "null"]},
        "end_dom_path": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "paragraph": {
      "type": "object",
      "required": ["fragments"],
      "properties": {"fragments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fragment"}}},
      "additionalProperties": false
    },
    "fragment": {
      "type": "object",
      "required": ["document_href", "spine_index", "dom_path", "element_tag", "document_sha256", "fragment_sha256", "has_ruby"],
      "properties": {
        "document_href": {"type": "string", "minLength": 1},
        "spine_index": {"type": "integer", "minimum": 0},
        "dom_path": {"type": "string", "pattern": "^/"},
        "element_tag": {"type": "string", "minLength": 1},
        "element_id": {"type": "string"},
        "document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fragment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "start_offset": {"type": "integer", "minimum": 0},
        "end_offset": {"type": "integer", "minimum": 1},
        "structural_type": {"enum": ["heading", "footnote"]},
        "has_ruby": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}
