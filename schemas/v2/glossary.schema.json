{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://castoff995.github.io/lotm-translator/schemas/v2/glossary.schema.json",
  "title": "LOTM v2 Human World Glossary",
  "type": "object",
  "required": ["schema_version", "work_id", "entries"],
  "properties": {
    "schema_version": {"const": "1.0-draft"},
    "work_id": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "zh_term", "en_term", "ru_term", "status", "aliases", "source_refs", "created", "updated"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "zh_term": {"type": "string", "minLength": 1},
          "en_term": {"type": "string", "minLength": 1},
          "ru_term": {"type": ["string", "null"]},
          "status": {"enum": ["needs_ru", "complete", "needs_review"]},
          "aliases": {
            "type": "object",
            "required": ["zh", "en", "ru"],
            "properties": {
              "zh": {"type": "array", "items": {"type": "string"}},
              "en": {"type": "array", "items": {"type": "string"}},
              "ru": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          },
          "source_refs": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["work_id", "chapter", "paragraph_id", "start_offset", "end_offset"],
              "properties": {
                "work_id": {"type": "string"}, "chapter": {"type": "integer", "minimum": 1},
                "paragraph_id": {"type": "string"}, "start_offset": {"type": "integer", "minimum": 0},
                "end_offset": {"type": "integer", "minimum": 1}
              },
              "additionalProperties": false
            }
          },
          "notes": {"type": ["string", "null"]},
          "created": {"$ref": "#/$defs/provenance"},
          "updated": {"$ref": "#/$defs/provenance"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["at", "actor", "tool_version"],
      "properties": {
        "at": {"type": "string"}, "actor": {"type": "string"}, "tool_version": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
